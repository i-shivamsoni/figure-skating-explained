{
  "name": "figure-skating-explained",
  "version": "0.1.0",
  "private": true,
  "description": "An interactive 3D guide to the elements of figure skating and how the ISU Judging System scores them, built from the ISU documents for the 2026-27 season.",
  "license": "MIT",
  "homepage": "https://figure-skating-explained.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-shivamsoni/figure-skating-explained.git"
  },
  "bugs": {
    "url": "https://github.com/i-shivamsoni/figure-skating-explained/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "data:sov": "node --experimental-strip-types scripts/parse-sov.mts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.18.0"
}
